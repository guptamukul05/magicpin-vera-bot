# Copy to .env and fill in only what you need. Every variable has a safe
# default (see the "Default" column) — the bot runs correctly with NO .env
# file at all.

# --- server -------------------------------------------------------------
PORT=8080                      # Default: 8080. Most PaaS providers set this for you.
HOST=0.0.0.0                   # Default: 0.0.0.0
LOG_LEVEL=INFO                 # Default: INFO. Try DEBUG for verbose request logs.

# --- optional LLM polish pass (composer.py works fully without this) ----
VERA_USE_LLM=0                 # Default: 0 (off). Set to 1 to enable.
VERA_LLM_PROVIDER=anthropic    # "anthropic" or "openai". Default: anthropic.
VERA_LLM_MODEL=                # Default: claude-sonnet-4-6 (anthropic) / gpt-4o-mini (openai)
ANTHROPIC_API_KEY=             # Required only if VERA_USE_LLM=1 and provider=anthropic
OPENAI_API_KEY=                # Required only if VERA_USE_LLM=1 and provider=openai

# --- GET /v1/metadata contents ------------------------------------------
VERA_TEAM_NAME="Team Vera-Plus-Plus"
VERA_TEAM_MEMBERS="Your Name"
VERA_CONTACT_EMAIL="you@example.com"
